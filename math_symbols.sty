% any other user-defined macros

\newcommand{\one}{\mathbbm{1}}
\newcommand{\regret}{\mathrm{Regret}}

% distributions
\newcommand{\Unif}{\mathrm{Unif}}
\newcommand{\Expo}{\mathrm{Exp}}
\newcommand{\Lap}{\mathrm{Lap}}
\newcommand{\op}{\mathrm{op}}

% for temporarily chunks of text
\newcommand{\ignore}[1]{}

% Probability/expectation operators.  The ones ending in x should be used if you want subscripts that go below and to the right; no x means the subscripts go directly *below* the operator (in math mode).
\renewcommand{\P}{\mathop{\mathbb{P}}}
\newcommand{\Px}{\mathbb{P}}
\newcommand{\E}{\mathop{\mathbb{E}}}
\newcommand{\Ex}{\mathbb{E}}
\newcommand{\Var}{\mathop{\operatorname{Var}}}
\newcommand{\Varx}{\operatorname{Var}}
\newcommand{\Cov}{\mathop{\operatorname{Cov}}}
\newcommand{\Covx}{\operatorname{Cov}}

% shortcuts for symbol names that are too long to type
\newcommand{\eps}{\epsilon}
\newcommand{\lam}{\lambda}
\newcommand{\la}{\langle}
\newcommand{\ra}{\rangle}
\newcommand{\wh}{\widehat}
\newcommand{\wt}{\widetilde}

% "blackboard-fonted" letters for the reals, naturals etc.
\newcommand{\RR}{\mathbb R}
\newcommand{\NN}{\mathbb N}
\newcommand{\ZZ}{\mathbb Z}
\newcommand{\FF}{\mathbb F}
\newcommand{\QQ}{\mathbb Q}
\newcommand{\CC}{\mathbb C}

% operators that should be typeset in Roman font
\newcommand{\poly}{\mathrm{poly}}
\newcommand{\polylog}{\mathrm{polylog}}
\newcommand{\sgn}{\mathrm{sgn}}
\newcommand{\avg}{\mathop{\mathrm{avg}}}
\newcommand{\val}{{\mathrm{val}}}

